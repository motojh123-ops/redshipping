datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

enum UserRole {
  super_admin
  company_admin
  sales_rep
  pricing_officer
  ops_officer
  clearance_broker
  accountant
  client_portal
  agent_portal
}

enum ClientStatus {
  prospect
  active
  inactive
  blacklisted
}

enum ShipmentType {
  fcl
  lcl
  air
  land
  clearance_only
}

enum IncotermType {
  EXW
  FCA
  CPT
  CIP
  DAP
  DPU
  DDP
  FAS
  FOB
  CFR
  CIF
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum ShipmentStage {
  booking_confirmed
  cargo_received
  customs_submitted
  acid_issued
  in_transit
  arrived_destination
  clearance_in_progress
  release_issued
  out_for_delivery
  delivered
  closed
  cancelled
}

enum ContainerType {
  GP_20     @map("20GP")
  GP_40     @map("40GP")
  HQ_40     @map("40HQ")
  HQ_45     @map("45HQ")
  RF_20     @map("20RF")
  RF_40     @map("40RF")
  FLAT_RACK
  OPEN_TOP
}

enum ContainerStatus {
  booked
  loaded
  on_board
  discharged
  gated_out
  delivered
  returned_empty
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
}

enum InvoiceType {
  client_freight
  client_clearance
  vendor_disbursement
}

enum VendorType {
  trucking
  clearance
  port_services
  warehousing
  fumigation
  inspection
}

enum ActivityType {
  call
  whatsapp
  email
  meeting
  note
}

enum DocumentCategory {
  bl
  packing_list
  commercial_invoice
  acid_cert
  cert_of_origin
  eur1
  customs_declaration
  delivery_order
  disbursement_receipt
  other
}

model Company {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String   @db.VarChar(255)
  commercialRegistration String?  @map("commercial_registration") @db.VarChar(100)
  taxNumber              String?  @map("tax_number") @db.VarChar(100)
  phone                  String?  @db.VarChar(50)
  email                  String?  @db.VarChar(150)
  address                String?  @db.Text
  logoUrl                String?  @map("logo_url") @db.Text
  currencyDefault        String   @default("EGP") @map("currency_default") @db.VarChar(3)
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users              User[]
  clients            Client[]
  clientContacts     ClientContact[]
  shippingLines      ShippingLine[]
  overseasAgents     OverseasAgent[]
  vendors            Vendor[]
  chargeItems        ChargeItem[]
  quotations         Quotation[]
  quotationItems     QuotationItem[]
  shipments          Shipment[]
  shipmentContainers ShipmentContainer[]
  shipmentEvents     ShipmentEvent[]
  shipmentCosts      ShipmentCost[]
  customsDossiers    CustomsDossier[]
  dispatchTrips      DispatchTrip[]
  notifications      Notification[]
  invoices           Invoice[]
  invoiceItems       InvoiceItem[]
  crmActivities      CrmActivity[]
  entityDocuments    EntityDocument[]
  scheduledReminders ScheduledReminder[]
  ports              Port[]
  drivers            Driver[]

  // ── Master Data expansion (spec session 1 — وثيقة المواصفات) ──
  cities                City[]
  measurementUnits      MeasurementUnit[]
  logisticsCats         LogisticsCategory[]
  portTypes             PortType[]
  shippingLineBranches  ShippingLineBranch[]
  shippingLineContacts  ShippingLineContact[]
  vendorBranches        VendorBranch[]
  vendorContacts        VendorContact[]
  overseasAgentBranches OverseasAgentBranch[]
  overseasAgentContacts OverseasAgentContact[]

  @@map("companies")
}

// ── Master Data: reference libraries & cities ──
model City {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  countryCode    String   @map("country_code") @db.VarChar(2)
  nameEn         String   @map("name_en") @db.VarChar(150)
  nameAr         String?  @map("name_ar") @db.VarChar(150)
  state          String?  @db.VarChar(150)
  cityCode       String?  @map("city_code") @db.VarChar(20)
  timezone       String?  @db.VarChar(64)
  latitude       Float?
  longitude      Float?
  isLogisticsHub Boolean  @default(false) @map("is_logistics_hub")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, countryCode, nameEn])
  @@index([companyId, countryCode])
  @@map("cities")
}

model MeasurementUnit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.VarChar(50)
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameAr    String?  @map("name_ar") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chargeItems ChargeItem[]

  @@unique([companyId, code])
  @@map("measurement_units")
}

model LogisticsCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.VarChar(50)
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameAr    String?  @map("name_ar") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chargeItems ChargeItem[]

  @@unique([companyId, code])
  @@map("logistics_categories")
}

model PortType {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.VarChar(50)
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameAr    String?  @map("name_ar") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ports   Port[]

  @@unique([companyId, code])
  @@map("port_types")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String    @db.VarChar(255)
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  role         UserRole  @default(sales_rep)
  avatarUrl    String?   @map("avatar_url") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  managedClients     Client[]            @relation("SalesRepClients")
  salesQuotations    Quotation[]         @relation("SalesRepQuotations")
  salesShipments     Shipment[]          @relation("SalesRepShipments")
  opsShipments       Shipment[]          @relation("OpsOfficerShipments")
  shipmentEvents     ShipmentEvent[]
  customsDossiers    CustomsDossier[]
  createdInvoices    Invoice[]
  crmActivities      CrmActivity[]
  uploadedDocuments  EntityDocument[]
  scheduledReminders ScheduledReminder[]

  @@unique([companyId, email])
  @@map("users")
}

model Client {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  name          String       @db.VarChar(255)
  tradeName     String?      @map("trade_name") @db.VarChar(255)
  taxNumber     String?      @map("tax_number") @db.VarChar(100)
  commercialReg String?      @map("commercial_reg") @db.VarChar(100)
  status        ClientStatus @default(prospect)
  salesRepId    String?      @map("sales_rep_id") @db.Uuid
  category      String?      @db.VarChar(100)
  address       String?      @db.Text
  city          String?      @db.VarChar(100)
  country       String       @default("Egypt") @db.VarChar(100)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesRep      User?           @relation("SalesRepClients", fields: [salesRepId], references: [id])
  contacts      ClientContact[]
  quotations    Quotation[]
  shipments     Shipment[]
  invoices      Invoice[]
  crmActivities CrmActivity[]

  @@map("clients")
}

model ClientContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String   @db.VarChar(255)
  title     String?  @db.VarChar(100)
  phone     String?  @db.VarChar(50)
  mobile    String?  @db.VarChar(50)
  email     String?  @db.VarChar(150)
  isPrimary Boolean  @default(false) @map("is_primary")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_contacts")
}

model Port {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  code        String   @db.VarChar(10)
  nameEn      String   @map("name_en") @db.VarChar(255)
  nameAr      String?  @map("name_ar") @db.VarChar(255)
  countryCode String   @map("country_code") @db.VarChar(2)
  portType    String   @default("sea") @map("port_type") @db.VarChar(20)
  portTypeId  String?  @map("port_type_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  company               Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  portTypeRef           PortType?   @relation(fields: [portTypeId], references: [id])
  originQuotations      Quotation[] @relation("OriginPort")
  destinationQuotations Quotation[] @relation("DestinationPort")
  originShipments       Shipment[]  @relation("ShipmentOriginPort")
  destinationShipments  Shipment[]  @relation("ShipmentDestinationPort")

  @@map("ports")
}

model ShippingLine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String   @db.VarChar(255)
  scac         String?  @db.VarChar(10)
  contactName  String?  @map("contact_name") @db.VarChar(150)
  contactEmail String?  @map("contact_email") @db.VarChar(150)
  contactPhone String?  @map("contact_phone") @db.VarChar(50)
  website      String?  @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipments Shipment[]
  branches  ShippingLineBranch[]
  contacts  ShippingLineContact[]

  @@map("shipping_lines")
}

model OverseasAgent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String   @db.VarChar(255)
  countryCode    String   @map("country_code") @db.VarChar(2)
  city           String   @db.VarChar(100)
  contactPerson  String?  @map("contact_person") @db.VarChar(150)
  contactEmail   String?  @map("contact_email") @db.VarChar(150)
  contactPhone   String?  @map("contact_phone") @db.VarChar(50)
  specialization String?  @db.VarChar(100)
  services       String[] @default([]) @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipments Shipment[]
  branches  OverseasAgentBranch[]
  contacts  OverseasAgentContact[]

  @@map("overseas_agents")
}

model Vendor {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  name          String     @db.VarChar(255)
  vendorType    VendorType @map("vendor_type")
  services      String[]   @default([]) @db.Text
  taxId         String?    @map("tax_id") @db.VarChar(50)
  contactName   String?    @map("contact_name") @db.VarChar(150)
  contactPhone  String?    @map("contact_phone") @db.VarChar(50)
  contactEmail  String?    @map("contact_email") @db.VarChar(150)
  address       String?    @db.Text
  phone         String?    @db.VarChar(50)
  commercialReg String?    @map("commercial_reg") @db.VarChar(100)
  crExpiry      DateTime?  @map("cr_expiry") @db.Date
  taxCardNumber String?    @map("tax_card_number") @db.VarChar(100)
  taxCardExpiry DateTime?  @map("tax_card_expiry") @db.Date
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipmentCosts ShipmentCost[]
  drivers       Driver[]
  branches      VendorBranch[]
  contacts      VendorContact[]

  @@map("vendors")
}

model ShippingLineBranch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  shippingLineId String   @map("shipping_line_id") @db.Uuid
  code           String?  @db.VarChar(50)
  name           String   @db.VarChar(150)
  address        String?  @db.Text
  city           String?  @db.VarChar(100)
  countryCode    String?  @map("country_code") @db.VarChar(2)
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(150)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shippingLine ShippingLine          @relation(fields: [shippingLineId], references: [id], onDelete: Cascade)
  contacts     ShippingLineContact[]

  @@unique([shippingLineId, name])
  @@index([companyId, shippingLineId])
  @@map("shipping_line_branches")
}

model ShippingLineContact {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  shippingLineId String   @map("shipping_line_id") @db.Uuid
  branchId       String?  @map("branch_id") @db.Uuid
  name           String   @db.VarChar(255)
  title          String?  @db.VarChar(100)
  phone          String?  @db.VarChar(50)
  mobile         String?  @db.VarChar(50)
  email          String?  @db.VarChar(150)
  isPrimary      Boolean  @default(false) @map("is_primary")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shippingLine ShippingLine        @relation(fields: [shippingLineId], references: [id], onDelete: Cascade)
  branch       ShippingLineBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId, shippingLineId])
  @@map("shipping_line_contacts")
}

model VendorBranch {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  code        String?  @db.VarChar(50)
  name        String   @db.VarChar(150)
  address     String?  @db.Text
  city        String?  @db.VarChar(100)
  countryCode String?  @map("country_code") @db.VarChar(2)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(150)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contacts VendorContact[]

  @@unique([vendorId, name])
  @@index([companyId, vendorId])
  @@map("vendor_branches")
}

model VendorContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  name      String   @db.VarChar(255)
  title     String?  @db.VarChar(100)
  phone     String?  @db.VarChar(50)
  mobile    String?  @db.VarChar(50)
  email     String?  @db.VarChar(150)
  isPrimary Boolean  @default(false) @map("is_primary")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor  Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  branch  VendorBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId, vendorId])
  @@map("vendor_contacts")
}

model OverseasAgentBranch {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  overseasAgentId String   @map("overseas_agent_id") @db.Uuid
  code            String?  @db.VarChar(50)
  name            String   @db.VarChar(150)
  address         String?  @db.Text
  city            String?  @db.VarChar(100)
  countryCode     String?  @map("country_code") @db.VarChar(2)
  phone           String?  @db.VarChar(50)
  email           String?  @db.VarChar(150)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overseasAgent OverseasAgent          @relation(fields: [overseasAgentId], references: [id], onDelete: Cascade)
  contacts      OverseasAgentContact[]

  @@unique([overseasAgentId, name])
  @@index([companyId, overseasAgentId])
  @@map("overseas_agent_branches")
}

model OverseasAgentContact {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  overseasAgentId String   @map("overseas_agent_id") @db.Uuid
  branchId        String?  @map("branch_id") @db.Uuid
  name            String   @db.VarChar(255)
  title           String?  @db.VarChar(100)
  phone           String?  @db.VarChar(50)
  mobile          String?  @db.VarChar(50)
  email           String?  @db.VarChar(150)
  isPrimary       Boolean  @default(false) @map("is_primary")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overseasAgent OverseasAgent        @relation(fields: [overseasAgentId], references: [id], onDelete: Cascade)
  branch        OverseasAgentBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId, overseasAgentId])
  @@map("overseas_agent_contacts")
}

model ChargeItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  code               String   @db.VarChar(50)
  nameEn             String   @map("name_en") @db.VarChar(255)
  nameAr             String   @map("name_ar") @db.VarChar(255)
  category           String   @db.VarChar(50)
  categoryId         String?  @map("category_id") @db.Uuid
  unitId             String?  @map("unit_id") @db.Uuid
  defaultCurrency    String   @default("USD") @map("default_currency") @db.VarChar(3)
  defaultPrice       Decimal? @map("default_price") @db.Decimal(12, 2)
  defaultSellPrice   Decimal? @map("default_sell_price") @db.Decimal(12, 2)
  notes              String?  @db.Text
  showInPricing      Boolean  @default(true) @map("show_in_pricing")
  showInQuotation    Boolean  @default(true) @map("show_in_quotation")
  showInInvoice      Boolean  @default(true) @map("show_in_invoice")
  showInDisbursement Boolean  @default(false) @map("show_in_disbursement")
  showInCommission   Boolean  @default(false) @map("show_in_commission")
  showInOperations   Boolean  @default(false) @map("show_in_operations")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unit           MeasurementUnit?   @relation(fields: [unitId], references: [id])
  categoryRef    LogisticsCategory? @relation(fields: [categoryId], references: [id])
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]
  shipmentCosts  ShipmentCost[]

  @@unique([companyId, code])
  @@map("charge_items")
}

model Quotation {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String          @map("company_id") @db.Uuid
  quotationNumber      String          @map("quotation_number") @db.VarChar(50)
  versionNumber        Int             @default(1) @map("version_number")
  parentQuotationId    String?         @map("parent_quotation_id") @db.Uuid
  clientId             String          @map("client_id") @db.Uuid
  salesRepId           String          @map("sales_rep_id") @db.Uuid
  originPortId         String?         @map("origin_port_id") @db.Uuid
  destinationPortId    String?         @map("destination_port_id") @db.Uuid
  shipmentType         ShipmentType    @map("shipment_type")
  incoterm             IncotermType
  status               QuotationStatus @default(draft)
  validUntil           DateTime        @map("valid_until") @db.Date
  currency             String          @default("USD") @db.VarChar(3)
  totalCost            Decimal         @default(0) @map("total_cost") @db.Decimal(14, 2)
