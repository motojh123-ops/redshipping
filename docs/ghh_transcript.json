      "text": " الoperaater بيبدأ يخش على خنات المرجعيات عشان يبدأ يخش على عميل زات نفسه لبقى اساسي بقى في خنات المرجعيات"
    },
    {
      "start": 565.88,
      "end": 574.88,
      "text": " ويقدر انه هو في الخنادي لما يضغط على العميل دا يظهر له بقى كل الداتة اللي كانت دخلة مبدأية للعميل"
    },
    {
      "start": 574.88,
      "end": 581.88,
      "text": " ويبدأ هو يقدر يديف مجموعة دا تانية خالصة ايه هي دا تانية بقى الركوان من السدوحة عايزة"
    },
    {
      "start": 581.88,
      "end": 587.88,
      "text": " انها اذا عايز سجلة وقاري وبتقدر بيه بتعمل لهم التش وبيتحطل لهم مسلمة"
    },
    {
      "start": 587.88,
      "end": 597.88,
      "text": " يعني اقدرت اخطار ان دا كمرشر جاستر وقدر اخطار ان دا تكست ايدي اقدر اخطار ان دا سجلة مصدرين"
    },
    {
      "start": 597.88,
      "end": 609.88,
      "text": " ويقدر انه هو يحدد ويكتب الايتم دا ويعمل لها التش ويحطلها فيلدتي يعني يحضر اكسبيريشن دايت او فيلدتي دايت واتفر"
    },
    {
      "start": 609.88,
      "end": 614.88,
      "text": " انه هو ويدي ارام بعد كده لو الاكسبيريشن دا دا عمل او اختبط"
    },
    {
      "start": 614.88,
      "end": 622.88,
      "text": " طيب اي تانية احتاجه اي احتاج انه هو يديف زي ما بنديف الخطوط وزي ما بنديف الوكل وزي ما بنديف المقاولين او الولفندرس"
    },
    {
      "start": 622.88,
      "end": 629.88,
      "text": " اقدر اي ديف برسون اند شارج وطيطل بتاعه ايميله ركوم تريفونه كل حاجة عام"
    },
    {
      "start": 629.88,
      "end": 635.88,
      "text": " من هنا اقدر اقول عناوين التحميلات برضو اقدر اي ديف اكتر من عينوان"
    },
    {
      "start": 635.88,
      "end": 642.88,
      "text": " اقدر اي ديف اكتر من برانج اقدر احدد ان دا الهد اوفيس دا المكان التحميل دا المخازن"
    },
    {
      "start": 642.88,
      "end": 650.88,
      "text": " اقدر احدد يبقى في برانجس لان هنتطر بعد كده نستخدمها في خانة الوباريشن"
    },
    {
      "start": 650.88,
      "end": 655.88,
      "text": " لما بيجي بعمل امر تحميل من خانة الترقنج اللي بوهها"
    },
    {
      "start": 655.88,
      "end": 659.88,
      "text": " هتطر ان اصحبها اصحبها منين اصحبها من الجزء اي ديف"
    },
    {
      "start": 659.88,
      "end": 663.88,
      "text": " العناوين افطر انه عانوين اللي هو بتاع التحميل"
    },
    {
      "start": 663.88,
      "end": 666.88,
      "text": " فدل احنا محتاجينه في قائمة الامل"
    },
    {
      "start": 666.88,
      "end": 672.88,
      "text": " اعتقد دا يعني ايه كل حاجة احنا هنكون محتاجين"
    }
  ]
