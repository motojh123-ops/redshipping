{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redshipping-api",
  "main": "api/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "alias": {
    "iconv-lite": "./scripts/empty.js",
    "@mapbox/node-pre-gyp": "./scripts/empty.js",
    "mock-aws-s3": "./scripts/empty.js",
    "aws-sdk": "./scripts/empty.js",
    "nock": "./scripts/empty.js",
    "@nestjs/websockets/socket-module": "./scripts/empty.js",
    "@nestjs/microservices/microservices-module": "./scripts/empty.js",
    "@nestjs/microservices": "./scripts/empty.js",
    "class-transformer/storage": "./scripts/empty.js"
  },
  // ⚠️ Sensitive values MUST be set as encrypted Wrangler secrets — NOT here:
  //   wrangler secret put DATABASE_URL
  //   wrangler secret put DIRECT_DATABASE_URL
  //   wrangler secret put JWT_SECRET
  //   wrangler secret put JWT_REFRESH_SECRET
  //   wrangler secret put ALLOWED_ORIGINS   (optional, comma-separated custom domains)
  "vars": {
    "NODE_ENV": "production"
  }
}
